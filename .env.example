# Public Supabase values (safe for the browser; RLS remains mandatory)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ENABLE_DEMO_MODE=false

# Server-only values — never prefix secrets with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Use the direct Supabase connection for migrations and the transaction pooler at runtime.
# Always require TLS when connecting to a hosted project.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_PASSWORD=local-only-change-me
REDIS_URL=redis://:local-only-change-me@127.0.0.1:6379
ADMIN_EMAIL=admin@example.com

# Marketplace credentials — server only
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
MERCADO_LIVRE_ACCESS_TOKEN=
SHOPEE_APP_ID=
SHOPEE_SECRET_REF=
SHOPEE_ACCESS_APPROVED=false
ALIEXPRESS_CREDENTIAL_REF=
ALIEXPRESS_ACCESS_APPROVED=false

# Messaging credentials — server only
TELEGRAM_BOT_TOKEN=
WHATSAPP_STATUS=not_configured
WHATSAPP_ELIGIBILITY_CONFIRMED=false
WHATSAPP_GROUPS_PERMISSION_CONFIRMED=false

# Optional AI text provider — server only
AI_TEXT_PROVIDER=disabled
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
