{
  "name": "promoflow",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @promoflow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:remote:status": "supabase migration list --linked",
    "db:remote:plan": "supabase db push --linked --dry-run",
    "db:remote:push": "supabase db push --linked",
    "db:generate": "pnpm --filter @promoflow/database db:generate",
    "db:migrate": "pnpm --filter @promoflow/database db:migrate",
    "db:check": "pnpm --filter @promoflow/database db:check",
    "migrations:validate": "node scripts/validate-migrations.mjs"
  },
  "devDependencies": {
    "next": "^15.5.4",
    "supabase": "^2.121.0"
  },
  "pnpm": { "overrides": { "postcss": ">=8.5.18" } }
}
